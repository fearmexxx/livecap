# Copy this file to .env.local (same folder) and fill in what you need.
# .env.local is read by the LiveCap server only. Nothing in it is sent to browsers or output screens.

# --- Translation / speech-to-text API keys (optional) ---
# With a key here, set Translation Engine to "Auto" in the console and the key never leaves this PC.
# OpenRouter: Gemini 2.5 Flash translation + openai/gpt-transcribe STT. https://openrouter.ai/keys
OPENROUTER_API_KEY=
# DeepL (keys ending in :fx use the free API)
DEEPL_API_KEY=
OPENAI_API_KEY=

# --- Room PIN (needed only for LAN mode) ---
# When set, any device that sends captions or uses the translate/transcribe API must enter this PIN
# in Settings -> API & AI -> Room PIN. Output screens (LED, vMix, OBS) only read and never need it.
# start_room.bat lan refuses to start without it.
LIVECAP_PIN=
