# LiveCap settings for this laptop. Open with Notepad / TextEdit, edit, save, restart LiveCap.
# Lines starting with # are ignored. Do not put spaces around the = sign.

# Recommended: an OpenRouter key gives much better Korean/English -> Vietnamese translation
# (Gemini 2.5 Flash, with context). Get one at https://openrouter.ai/keys
# Without a key LiveCap still works, using free Google Translate.
OPENROUTER_API_KEY=

# Optional alternatives
DEEPL_API_KEY=
OPENAI_API_KEY=

# Port for the console in Chrome (http://localhost:3000/caption). Change only if 3000 is taken.
PORT=3000

# Only if vMix / the LED runs on ANOTHER computer in the same room:
# set LIVECAP_LAN=1 and choose a PIN. Other computers then open http://<this-laptop-ip>:3000/caption/overlay
LIVECAP_LAN=0
LIVECAP_PIN=
